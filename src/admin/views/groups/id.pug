extends ../layout.pug
include ../partials/mixins
block content
    .mb-5
        div.d-flex.align-items-center.gap-3
            a.text-decoration-none(href='/admin/groups/').fs-4
                i.bi.bi-arrow-left.fst-normal= "  back"
            h1.text-capitalize.mb-0= record.name
    .row
        .border.rounded.py-3.px-4.bg-white.shadow-sm.row.m-0.col
            each field in ['name', 'description']
                    .mb-5.col-6
                        p.form-label.fw-bold.text-capitalize= field
                        .form-control.border-0= record[field]
            .col 
                p.form-label.fw-bold.text-capitalize Members
                    if (!record.users.length)
                        p.text-secondary No assigned members
                ul.list-unstyled.ps-2
                    each user in record.users
                        li.mb-3(style={width: '350px'})
                            a.d-block.text-decoration-none(href=`/admin/users/${user.id}`)= user.username +" | "+user.email
            .col 
                +service-permission-list(permissions)


        .col-2
            .border.bg-white.p-3.rounded.mb-2
                p 
                    span.d-block Created: 
                    small.text-capitalize= helpers.formattedDate(record.created_at)
                p 
                    span.d-block Updated: 
                    small.text-capitalize= helpers.formattedDate(record.updated_at)
            a.btn.btn-primary.w-100.mb-2(href=`edit/${record.id}`) update
            form(action=record.id method='DELETE')
                button.btn.btn-danger.w-100 delete
