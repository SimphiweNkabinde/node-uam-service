mixin service-permission-list(permissions)
    .col-6
        p.form-label.fw-bold Permissions
        if (!permissions.length) 
            p.text-secondary No assigned permissions 
        else
            - const groupedPermissions = Object.groupBy(permissions, gr => gr.service_name)
            - const serviceNames = Object.keys(groupedPermissions)
            ul.list-unstyled.ps-2
                each service in serviceNames
                    li.mb-3
                        a.d-block.text-decoration-none(href=`/admin/services/${groupedPermissions[service][0].service_id}`)= service
                        ul.list-unstyled.ps-2
                            each permission in groupedPermissions[service]
                                li.text-secondary= permission.name 

mixin text-fields-list(values, fields, routeName)
    each field in fields
        form.col-6(action=`/admin/${routeName}/${values.id}` method='POST')
            label(for=field).form-label.fw-bold.text-capitalize= field
            input(type="hidden" name="_method" value="PUT")
            .d-flex.column-gap-1
                input.form-control.form-control-s.input-touched-focus(value=values[field] name=field id=field onChange='this.classList.add("input-touched")')
                button.btn.btn-sm.btn-primary(style={'font-size':'0.75rem', padding:'0.25rem 0.5rem'}) save


mixin group-list(groups)
    .col-6
        p.form-label.fw-bold Groups
        if (!groups.length)
            p.text-secondary No assigned groups
        ul.list-unstyled.ps-2
            each group in groups
                li.mb-3
                    a.d-block.text-decoration-none(href=`/admin/groups/${group.id}`)
                        span= group.name
                        small.text-secondary= " : " + group.description

mixin timestamp-card(createdAt, updatedAt)
    .border.bg-white.p-3.rounded.mb-2
        p 
            span.d-block Created: 
            small.text-capitalize= helpers.formattedDate(createdAt)
        p 
            span.d-block Updated: 
            small.text-capitalize= helpers.formattedDate(updatedAt)

mixin add-permission(serviceId)
    form.d-flex.column-gap-1(action='/admin/permissions' method='POST')
        input.form-control.form-control-sm(placeholder='new permission' name='name' required)
        input.form-control.form-control-sm(placeholder='short description' name='description' required)
        input(type='hidden' name='serviceId' value=serviceId required)
        button.btn.btn-primary +

mixin delete-permission(serviceId, permissionId)
    form.ms-2(action=`/admin/permissions/${serviceId}/${permissionId}` method='POST')
        input(type='hidden' name='_method' value='DELETE')
        button.border-0.bg-transparent.text-danger-emphasis.bi.bi-trash3-fill