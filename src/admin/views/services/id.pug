extends ../layout.pug
block content
    .mb-5
        div.d-flex.align-items-center.gap-3
            a.text-decoration-none(href='/admin/services/').fs-4
                i.bi.bi-arrow-left.fst-normal= "  back"
            h1.text-capitalize.mb-0= record.name
    .row
        .border.rounded.py-3.px-4.bg-white.shadow-sm.row.m-0.col
            +text-fields-list(record, ['name', 'description'])
            .col-6
                p.form-label.fw-bold.text-capitalize Permissions
                if (!record.permissions.length)
                    p.text-secondary No assigned permissions
                ul.list-unstyled.ps-2(style={width: '350px'})
                    each permission in record.permissions
                        li.mb-2
                            span= permission.name
                            small.text-secondary= " : " + permission.description
                .ps-2
                    +add-permission(record.id)
        .col-2
            +timestamp-card(record.created_at, record.updated_at)
            a.btn.btn-primary.w-100.mb-2(href=`edit/${record.id}`) update
            form(action=record.id method='DELETE')
                button.btn.btn-danger.w-100 delete
