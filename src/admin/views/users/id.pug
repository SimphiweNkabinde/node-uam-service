extends ../layout.pug
block content
    .mb-5
        div.d-flex.align-items-center.gap-3
            a.text-decoration-none(href='/admin/users/').fs-4
                i.bi.bi-arrow-left.fst-normal= "  back"
            h1.text-capitalize.mb-0= record.username
    .row
        .border.rounded.py-3.px-4.bg-white.shadow-sm.row.m-0.col.row-gap-5
            +text-fields-list(record, ['username', 'email'], 'users', false)
            .col-6
                +service-permission-list(record.permissions)
                - const permissionIds =  record.permissions.map(p => p.id)
                +assign-permission-to-user(permissions.filter(p => !permissionIds.includes(p.id)))
            .col-6
                +group-list(record.groups)
                - const groupIds =  record.groups.map(g => g.id)
                +assign-user-to-group(groups.filter(g => !groupIds.includes(g.id)))

        .col-2
            +timestamp-card(record.created_at, record.updated_at)
            +delete-entity-button('users',record.id)

