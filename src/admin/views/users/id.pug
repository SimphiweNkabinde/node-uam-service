extends ../layout.pug
block content
    .mb-5
        div.d-flex.align-items-center.gap-3
            a.text-decoration-none(href='/admin/users/').fs-4
                i.bi.bi-arrow-left.fst-normal= "  back"
            h1.text-capitalize.mb-0= record.username
    .row
        .border.rounded.py-3.px-4.bg-white.shadow-sm.row.m-0.col
            each field in ['username', 'email']
                    .mb-5.col-6
                        p.form-label.fw-bold.text-capitalize= field
                        .form-control.border-0= record[field]
            .col
                p.fs-4 Permissions
                if (!record.servicePermissions.length)
                    p.text-secondary No assigned permissions
                ul.list-unstyled.ps-1
                    each service in record.servicePermissions
                        li.mb-3(style={width: '300px'})
                            a.d-block.text-decoration-none(href=`/admin/services/${service.id}`)
                                p.text-capitalize.mb-1= service.name
                                ul
                                    each permission in service.permissions
                                        li.text-dark= permission.name 
            .col.mb-5
                p.fs-4 Groups
                if (!record.groups.length)
                    p.text-secondary No assigned groups
                ul.list-unstyled.ps-2
                    each group in record.groups
                        li.mb-3(style={width: '350px'})
                            a.btn.btn-outline-primary.text-start.border.d-block.py-2.px-3.rounded.text-decoration-none(href=`/admin/groups/${group.id}`)
                                p.mb-1.text-capitalize= group.name
                                small= group.description

        .col-2
            .border.bg-white.p-3.rounded.mb-2
                p 
                    span.d-block Created: 
                    small.text-capitalize= helpers.formattedDate(record.created_at)
                p 
                    span.d-block Updated: 
                    small.text-capitalize= helpers.formattedDate(record.updated_at)
            a.btn.btn-primary.w-100.mb-2(href=`edit/${record.id}`) update
            form(action=record.id method='DELETE')
                button.btn.btn-danger.w-100 delete
